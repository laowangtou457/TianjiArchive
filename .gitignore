# ---------------------------------------------------------------- 依赖与构建产物
node_modules/
dist/
build/
.turbo/
coverage/
*.tsbuildinfo
packages/shared/.build/

# ---------------------------------------------------------------- 环境与密钥
# .env 含真实口令，绝不入库；.env.example 是模板，必须入库
.env
.env.local
.env.*.local
!.env.example

# ---------------------------------------------------------------- 离线部署包产物
# 镜像 tar 可达数 GB，绝不入库；SHA256SUMS 由 save-images.sh 现场生成。
/offline/tianji-offline-images.tar
/offline/SHA256SUMS
# 构建锚定清单：由 save-images.sh --record 在构建机现场生成，含机器相关 Image ID
# 与构建时 git HEAD，随离线包一同交付；与 SHA256SUMS 同属生成物，禁止入库防陈旧。
/offline/BUILD-INFO.txt
/offline/volumes/
/offline/*.log

# ---------------------------------------------------------------- 安装包产物
# client-lite 的 zip 由 installer/client-lite/ 下的源文件现场打包生成（含 BOM/CRLF
# 与 zip 中文文件名等平台相关字节），入库会随平台漂移，故不入库；源文件必须入库。
/installer/client-lite/*.zip
# 变体载荷（.deb 闭包 / docker static tgz）由构建机现场抓取，体积大且平台相关。
# 注意只忽略这两个目录，不能写成 payload/（会把 common/ 一起吞掉）。
/installer/build/payload/ubuntu-debian/
/installer/build/payload/kylin-uos/

# ---------------------------------------------------------------- 定向豁免：installer/build
# 上面第 4 行的 `build/` 是**无锚点**规则，会把 installer/build/ 整个吞掉（实测
# git check-ignore 命中 .gitignore:4）。该目录是安装包**源码**（构建脚本 + 载荷模板），
# 必须入库。同类缺陷本项目已踩过一次（见下方「运行时数据卷」段的说明）。
# 由于 git 不允许在「父目录被排除」后重新包含其中的文件，这里豁免的正是被排除的
# 那个目录本身，其内容随后即恢复正常可见。
!/installer/build/

# ---------------------------------------------------------------- 运行时数据卷
# docker compose 的宿主机挂载目录（PG/ES/SeaweedFS/Redis 数据 + WAL 归档）
# 注意：以下目录模式必须锚定根路径（前导 /），否则无锚点的 backup/
# 会匹配任意深度同名目录——曾致 apps/api/src/modules/backup 整个模块
# 从未入库（2026-11-07 联调发现）。
/volumes/
/data/

# ---------------------------------------------------------------- 备份产物
/backups/
/backup/
*.dump
*.dump.gz
*.sql.gz
*.tar.gz
*.tgz
*.zip

# ---------------------------------------------------------------- 迁移/压测临时文件
apps/cli-migrator/*.sqlite
apps/cli-migrator/*.db
.tianji-migrate.db
# SeaweedFS 实测临时目录（曾 bind-mount 到 tj-sw-* 遗留容器）；必须锚定根路径，
# 无锚点的同名模式会误伤任意深度目录（见上方 backup/ 事故教训）。
/.tmp-sw-*/

# ---------------------------------------------------------------- 本地真机验证脚本与样本（不入库）
/.wb-e2e/

# ---------------------------------------------------------------- 日志与系统文件
*.log
# 例外：压测原始输出是交付证据链，必须在干净克隆中可取到。
# 全局 *.log 曾把 docs/perf/runs/ 四份现场日志全部吞掉，而 DEV-PROCESS.md §8.6
# 与 QA-REPORT.md 明确引用它们（与已修的「gitignore 无锚点炸弹」同属
# 「文档写了、仓库里没有」缺陷，故此处显式开白名单）。
!docs/perf/runs/*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# ---------------------------------------------------------------- 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo

# ---------------------------------------------------------------- 测试与调试
htmlcov/
.vitest-cache/
*.lcov
