{
  "name": "@tianji/api",
  "version": "1.0.0",
  "private": true,
  "description": "天玑档案管理系统 —— NestJS 后端 API",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migration:run": "typeorm-ts-node-commonjs migration:run -d src/infra/database/data-source.ts",
    "migration:revert": "typeorm-ts-node-commonjs migration:revert -d src/infra/database/data-source.ts",
    "migration:generate": "typeorm-ts-node-commonjs migration:generate -d src/infra/database/data-source.ts",
    "schema:sync": "node dist/scripts/dev-sync-schema.js",
    "seed": "ts-node src/scripts/seed.ts",
    "perf:danghao": "ts-node src/scripts/danghao-concurrency-bench.ts",
    "perf:search": "ts-node src/scripts/search-bench.ts",
    "s3:probe": "ts-node src/scripts/seaweedfs-s3-probe.ts",
    "presign:host": "ts-node src/scripts/presign-host-probe.ts",
    "demo:books": "ts-node src/scripts/demo-books-seed.ts",
    "verify:params": "ts-node src/scripts/verify-params.ts"
  },
  "dependencies": {
    "@elastic/elasticsearch": "^8.15.0",
    "@nestjs/bullmq": "^10.2.1",
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/typeorm": "^10.0.2",
    "@tianji/shared": "workspace:*",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.13.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "minio": "^8.0.1",
    "multer": "^1.4.5-lts.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.2"
  }
}
