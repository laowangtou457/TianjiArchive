== [1] unit 文件（验证四要素）==
[Unit]
Description=Docker Application Container Engine (tianji static install)
Documentation=https://docs.docker.com
After=network-online.target firewalld.service
Wants=network-online.target
# 上限给足尝试机会（120s 内 5 次），超过则 failed 态可见，而不是无限 auto-restart
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=notify
# 静态目录放最前（dockerd 要经 PATH 找 docker-proxy / containerd），系统目录兜底
Environment=PATH=/usr/local/lib/tianji/docker-static:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/lib/tianji/docker-static/dockerd --userland-proxy-path=/usr/local/lib/tianji/docker-static/docker-proxy
ExecStartPost=/usr/local/lib/tianji/docker-static/wait-ready.sh
ExecReload=/bin/kill -s HUP $MAINPID
TimeoutStartSec=0
RestartSec=2
Restart=on-failure
LimitNOFILE=65535
LimitMEMLOCK=infinity
LimitNPROC=infinity
LimitCORE=infinity
TasksMax=infinity
Delegate=yes
KillMode=process
OOMScoreAdjust=-500

[Install]
WantedBy=multi-user.target
