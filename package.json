{
  "name": "tianji-archive-local",
  "version": "1.0.0",
  "private": true,
  "description": "天玑档案管理系统本地复刻 —— pnpm monorepo 根工程",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build:shared": "pnpm --filter @tianji/shared build",
    "build": "pnpm run build:shared && pnpm -r --filter=!@tianji/shared build",
    "typecheck": "pnpm run build:shared && pnpm -r --filter=!@tianji/shared typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:shared": "vitest run packages/shared",
    "test:api": "vitest run apps/api",
    "lint": "eslint \"{apps,packages}/**/src/**/*.{ts,tsx}\" --max-warnings=0",
    "ci:check:perm-mutations": "node scripts/ci-check-permission-mutations.cjs",
    "ci:check": "pnpm run ci:check:perm-mutations && pnpm run lint",
    "lint:fix": "eslint \"{apps,packages}/**/src/**/*.{ts,tsx}\" --fix",
    "format": "prettier --write \"{apps,packages}/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"{apps,packages}/**/*.{ts,tsx,json,css,md}\"",
    "dev:api": "pnpm --filter @tianji/api start:dev",
    "dev:web": "pnpm --filter @tianji/web dev",
    "dev:extractor": "pnpm --filter @tianji/extractor start:dev",
    "migration:run": "pnpm --filter @tianji/api migration:run",
    "migration:revert": "pnpm --filter @tianji/api migration:revert",
    "seed": "pnpm --filter @tianji/api seed",
    "perf:danghao": "pnpm --filter @tianji/api perf:danghao",
    "up": "docker compose up -d",
    "down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.1",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "vitest": "^2.1.9"
  }
}
