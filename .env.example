# ============================================================================
# 天玑档案管理系统 —— 环境变量样例（复制为 .env 后按单位实情修改）
# 所有服务通过 docker-compose 的 env_file 读取本文件
# ============================================================================

# ---------------------------------------------------------------- 运行环境
NODE_ENV=production
TZ=Asia/Shanghai

# ---------------------------------------------------------------- PostgreSQL 16
POSTGRES_HOST=postgres
# 容器内连接端口（应用连库用，不要改）
POSTGRES_PORT=5432
# 宿主机暴露端口（本机已有 PG 时改成 5433 避免冲突）
POSTGRES_EXPOSED_PORT=5432
POSTGRES_DB=tianji_archive
POSTGRES_USER=tianji
POSTGRES_PASSWORD=tianji_pwd_change_me

# ---------------------------------------------------------------- Elasticsearch 8 (含 IK 分词)
ES_NODE=http://elasticsearch:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=archive_items
# IK 镜像构建参数（改了需 docker compose build elasticsearch 重建，见 docs/DEPLOY.md）
ES_VERSION=8.13.4
IK_VERSION=8.13.4
# ES 堆内存：本机试点 1g 够用；压测/perf:danghao 建议 2g（数据量小时 1g 也行）
ES_JAVA_OPTS=-Xms1g -Xmx1g
# 宿主机暴露端口（本机已有 ES 时改成 9201 避免冲突）
ES_EXPOSED_PORT=9200

# ---------------------------------------------------------------- MinIO 对象存储
MINIO_ENDPOINT=minio
# 容器内连接端口（应用连对象存储用，不要改）
MINIO_PORT=9000
MINIO_USE_SSL=false
# 宿主机暴露端口：S3 API / 管理控制台
MINIO_EXPOSED_PORT=9000
MINIO_CONSOLE_EXPOSED_PORT=9001
MINIO_ACCESS_KEY=tianji_minio
MINIO_SECRET_KEY=tianji_minio_change_me
MINIO_BUCKET_ORIGINAL=archive-original
MINIO_BUCKET_PREVIEW=archive-preview
MINIO_BUCKET_THUMB=archive-thumb
MINIO_BUCKET_BACKUP=archive-backup

# ---------------------------------------------------------------- Redis 7（缓存/队列）
REDIS_HOST=redis
# 容器内连接端口（不要改）
REDIS_PORT=6379
# 宿主机暴露端口
REDIS_EXPOSED_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------- 应用与安全
API_PORT=3000
# 宿主机暴露端口（本机已有服务占 3000 时改 3001）
API_EXPOSED_PORT=3000
API_PREFIX=api
JWT_ACCESS_SECRET=please_change_this_access_secret_32chars
JWT_REFRESH_SECRET=please_change_this_refresh_secret_32chars
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BCRYPT_ROUNDS=10
# 密码策略：最小长度 / 有效期(天) / 连续失败锁定次数 / 锁定分钟
PWD_MIN_LENGTH=10
PWD_EXPIRE_DAYS=90
PWD_MAX_FAILED=5
PWD_LOCK_MINUTES=30
# 预览水印与下载开关（PRD Q4 默认：预览加水印、下载需审批）
PREVIEW_WATERMARK=true
DOWNLOAD_ENABLED=false

# ---------------------------------------------------------------- 抽取 Worker
EXTRACT_CONCURRENCY=4
EXTRACT_QUEUE_NAME=archive-extract
OFFICE_SOFFICE_PATH=/usr/bin/soffice
FFMPEG_PATH=/usr/bin/ffmpeg
THUMB_MAX_EDGE=480

# ---------------------------------------------------------------- 备份
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backup

# ---------------------------------------------------------------- 前端
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------- Web 端口
WEB_PORT=8080
