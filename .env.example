# ============================================================================
# 天玑档案管理系统 —— 环境变量样例（复制为 .env 后按单位实情修改）
# 所有服务通过 docker-compose 的 env_file 读取本文件
# ============================================================================

# ---------------------------------------------------------------- 运行环境
NODE_ENV=production
TZ=Asia/Shanghai

# ---------------------------------------------------------------- PostgreSQL 16
POSTGRES_HOST=postgres
# 容器内连接端口（应用连库用，不要改）
POSTGRES_PORT=5432
# 宿主机暴露端口（本机已有 PG 时改成 5433 避免冲突）
POSTGRES_EXPOSED_PORT=5432
POSTGRES_DB=tianji_archive
POSTGRES_USER=tianji
POSTGRES_PASSWORD=tianji_pwd_change_me

# ---------------------------------------------------------------- Elasticsearch 8 (含 IK 分词)
ES_NODE=http://elasticsearch:9200
ES_USERNAME=
ES_PASSWORD=
ES_INDEX=archive_items
# IK 镜像构建参数（改了需 docker compose build elasticsearch 重建，见 docs/DEPLOY.md）
ES_VERSION=8.13.4
IK_VERSION=8.13.4
# ES 堆内存：本机试点 1g 够用；压测/perf:danghao 建议 2g（数据量小时 1g 也行）
ES_JAVA_OPTS=-Xms1g -Xmx1g
# 宿主机暴露端口（本机已有 ES 时改成 9201 避免冲突）
ES_EXPOSED_PORT=9200

# ---------------------------------------------------------------- 对象存储（S3 兼容端点）
# 实现：SeaweedFS 3.79 S3 Gateway（方案 A），替代已归档停服的 MinIO 开源版。
# MINIO_* 是**历史变量名**（S3 兼容端点配置），为兼容 configuration.ts /
# cli-migrator / extractor / backup.sh 保留原名，不代表使用 MinIO 服务端；
# 全流程不再依赖 minio/minio、minio/mc 镜像或 dl.min.io（已 410）。
# 应用侧 minio npm SDK 以 pathStyle + us-east-1 直连 SeaweedFS 8333。
#
# 内部端点（服务端 S3 操作：桶/PUT/GET/HEAD/multipart/列举/删除）：
MINIO_ENDPOINT=seaweedfs
# 容器内连接端口（S3 API，不要改）
MINIO_PORT=8333
MINIO_USE_SSL=false
# 宿主机暴露端口：R-2 裁定只发布 S3(8333)；master 9333 / filer 8888 /
# volume 8081(避开 web 宿主 8080) / gRPC 端口一律只在容器网络内，不发布宿主。
SEAWEEDFS_S3_EXPOSED_PORT=8333
#
# R-1 双端点：预签名 URL（分片直传/预览下载的浏览器直连地址）。
# SigV4 签名含 Host，容器 DNS `seaweedfs` 浏览器无法解析，故独立配置。
# 仅「签发」预签名 URL 使用；服务端 S3 操作仍走上面的 MINIO_ENDPOINT。
# 本机 demo：浏览器与 Docker 同机，保持下面占位符对应的默认值 127.0.0.1:8333 即可。
# 封闭环境（应用在服务器、浏览器在局域网其它机器）：必须把占位符改成
#   **宿主机局域网 IP**（浏览器可直连 8333），例如 192.168.10.50；
#   端口须与 SEAWEEDFS_S3_EXPOSED_PORT 一致。这是本次交付的现场必改项，
#   属 R-10 留给用户确认项之一，本文件只放占位符、不代拍板具体 IP。
# S3_PUBLIC_ENDPOINT=<封闭环境宿主机局域网IP；本机 demo 用 127.0.0.1>
# S3_PUBLIC_PORT=8333
# S3_PUBLIC_USE_SSL=false
#
# S3 凭据：同时作为 SeaweedFS s3.json 的 identities.credentials，
# 由 infra/seaweedfs/entrypoint.sh 在容器启动时从环境变量渲染，绝不入库。
# 真实凭据只放在未入库的 .env 中；本模板文件仅示例值。
MINIO_ACCESS_KEY=tianji_minio
MINIO_SECRET_KEY=tianji_minio_change_me
MINIO_BUCKET_ORIGINAL=archive-original
MINIO_BUCKET_PREVIEW=archive-preview
MINIO_BUCKET_THUMB=archive-thumb
MINIO_BUCKET_BACKUP=archive-backup

# ---------------------------------------------------------------- Redis 7（缓存/队列）
REDIS_HOST=redis
# 容器内连接端口（不要改）
REDIS_PORT=6379
# 宿主机暴露端口
REDIS_EXPOSED_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ---------------------------------------------------------------- 应用与安全
API_PORT=3000
# 宿主机暴露端口（本机已有服务占 3000 时改 3001）
API_EXPOSED_PORT=3000
API_PREFIX=api
JWT_ACCESS_SECRET=please_change_this_access_secret_32chars
JWT_REFRESH_SECRET=please_change_this_refresh_secret_32chars
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=14d
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
BCRYPT_ROUNDS=10
# 密码策略：最小长度 / 有效期(天) / 连续失败锁定次数 / 锁定分钟
PWD_MIN_LENGTH=10
PWD_EXPIRE_DAYS=90
PWD_MAX_FAILED=5
PWD_LOCK_MINUTES=30
# 预览水印与下载开关（PRD Q4 默认：预览加水印、下载需审批）
PREVIEW_WATERMARK=true
DOWNLOAD_ENABLED=false

# ---------------------------------------------------------------- 抽取 Worker
EXTRACT_CONCURRENCY=4
EXTRACT_QUEUE_NAME=archive-extract
OFFICE_SOFFICE_PATH=/usr/bin/soffice
FFMPEG_PATH=/usr/bin/ffmpeg
THUMB_MAX_EDGE=480

# ---------------------------------------------------------------- 备份
BACKUP_CRON=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=/backup

# ---------------------------------------------------------------- 前端
VITE_API_BASE_URL=/api

# ---------------------------------------------------------------- Web 端口
WEB_PORT=8080
